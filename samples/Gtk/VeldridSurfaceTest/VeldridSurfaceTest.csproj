<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VeldridSurfaceTest</RootNamespace>
    <Nullable>enable</Nullable>
    <!--
      AllowUnsafeBlocks is NOT required for the sample itself.
      Veldrid's native interop is handled internally by the Veldrid package.
    -->
  </PropertyGroup>

  <!--
    LD_LIBRARY_PATH ensures the GTK3/Vulkan loader finds system libraries when
    launched from an IDE that does not inherit the login shell's PATH.
  -->
  <PropertyGroup Condition=" '$(RunConfiguration)' == 'Default' ">
    <StartAction>Project</StartAction>
    <ExternalConsole>false</ExternalConsole>
    <EnvironmentVariables>
      <Variable name="LD_LIBRARY_PATH" value="/usr/local/lib:/usr/lib" />
    </EnvironmentVariables>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Veldrid        — cross-platform graphics API (Vulkan / OpenGL / D3D11 / Metal).
      Veldrid.SPIRV  — runtime GLSL→SPIR-V compilation + backend cross-compilation.
                       Ships libveldrid-spirv.so (Linux), veldrid-spirv.dll (Windows),
                       and libveldrid-spirv.dylib (macOS) as native NuGet assets.
    -->
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Eto\Eto.csproj" />
    <ProjectReference Include="..\..\..\src\Eto.Gtk\Eto.Gtk.csproj" />
  </ItemGroup>

</Project>
